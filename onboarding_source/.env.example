# Copy values into ../.env; the existing private .env is never overwritten.
MICROSOFT_GRAPH_TENANT_ID=your-tenant
MICROSOFT_GRAPH_CLIENT_ID=your-application
MICROSOFT_GRAPH_CLIENT_SECRET=your-secret
MICROSOFT_GRAPH_USER_ID=your-mailbox
LLM_PROVIDER=openai_compatible
LLM_API_HOST=https://your-api-host/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model
LLM_TIMEOUT_SECONDS=300
# Optional for gateways that accept the enable_thinking request parameter.
# LLM_ENABLE_THINKING=false
ONBOARDING_BACKEND=lark
LARK_APP_ID=your-app-id
LARK_APP_SECRET=your-app-secret
LARK_BRAND=lark
LARK_USER_SCOPES=bitable:app offline_access
# Written by setup_lark.py --create after user authorization:
LARK_BASE_TOKEN=
LARK_BASE_URL=
LARK_MAIL_TABLE_ID=
LARK_PROGRESS_TABLE_ID=
